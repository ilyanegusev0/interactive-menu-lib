<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		
		<TargetFrameworks>net10.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageIcon>interactive-menu-logo.png</PackageIcon>
		<PackageId>InteractiveMenu</PackageId>
		<Title>InteractiveMenu</Title>
		<Version>1.0.0</Version>
		<Authors>ilyanegusev</Authors>
		<Description>InteractiveMenu is a lightweight C# library for creating interactive console menus with navigation, selection, and customizable appearance.</Description>

		<RepositoryUrl>https://github.com/ilyanegusev0/interactive-menu-lib</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		
	</PropertyGroup>

	<ItemGroup>
		<None Include="../docs/interactive-menu-logo.png" Pack="true" PackagePath="" />
		<None Include="../README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
